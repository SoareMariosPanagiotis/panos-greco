# Copiază fișierul ăsta în .env și pune valori proprii.
# .env nu intră niciodată în git (e în .gitignore).
# Parolele: doar litere, cifre și underscore, ca să meargă și în adresele de conectare.

# Baza de date (containerul panos-db)
POSTGRES_USER=panos
POSTGRES_PASSWORD=schimba_parola_1
POSTGRES_DB=panos_greco

# Parolele rolurilor folosite de API (PostGraphile) și de poștaș
POSTGRES_API_PASSWORD=schimba_parola_2
POSTGRES_MAILER_PASSWORD=schimba_parola_3

# Cheia cu care PostGraphile semnează biletele de login (JWT): un șir lung și aleatoriu
JWT_SECRET=schimba_cu_un_sir_lung_si_aleatoriu
